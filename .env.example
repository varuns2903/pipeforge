# API Settings
PORT=3000
NODE_ENV=development
API_URL=http://localhost:3000
WEB_URL=http://localhost:5173

# Read by apps/web at build time (Vite inlines VITE_-prefixed vars) — the
# base URL it calls the API on. Defaults to http://localhost:3000 if unset.
VITE_API_URL=http://localhost:3000

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/pipeforge

# Redis (BullMQ / Queue)
REDIS_HOST=localhost
REDIS_PORT=6380

# Authentication
JWT_SECRET=super_secret_jwt_key_replace_in_production
JWT_EXPIRES_IN=7d

# Encrypts saved data-source connection credentials (Postgres passwords, S3
# keys, API tokens) at rest — required, no default. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONNECTION_ENCRYPTION_KEY=replace_with_a_generated_64_char_hex_key

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# Pipeline execution (worker) — caps how many rows a single node's output can
# hold in memory. A source read (csv-input/json-input) or a join that would
# exceed this fails the execution with a clear error instead of risking an
# OOM. Raise this only alongside worker memory limits.
MAX_PIPELINE_ROWS=200000

# Worker concurrency — how many pipeline executions one worker process runs
# at once. Higher = more throughput but more memory pressure per instance.
WORKER_CONCURRENCY=5

# Per-user quotas for the Free plan (see apps/api/src/config/plans.ts — the
# Pro plan multiplies these). Tune as real usage comes in; there's no code
# change needed to adjust these.
MAX_USER_STORAGE_MB=500
MAX_CONCURRENT_EXECUTIONS_PER_USER=5

# Email (SMTP) — optional. Without these set, verification/reset emails are
# logged instead of sent, so those flows still work end-to-end in dev.
# Any standard SMTP provider works (SES, SendGrid, Postmark, Mailgun, etc.)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=PipeForge <no-reply@yourdomain.com>

# Billing (Stripe, test mode) — required for the Pro plan upgrade flow.
# STRIPE_SECRET_KEY: Dashboard → Developers → API keys ("Secret key", starts sk_test_...)
# STRIPE_PRICE_ID_PRO: Dashboard → Product catalog → create a recurring price for the
#   Pro plan, then copy its id (starts price_..., NOT the prod_... product id)
# STRIPE_WEBHOOK_SECRET: for local dev, run `stripe listen --forward-to
#   localhost:3000/api/billing/webhook` (Stripe CLI) — it prints this value;
#   in production, create a webhook endpoint in the dashboard instead
STRIPE_SECRET_KEY=sk_test_replace_with_your_test_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_your_webhook_signing_secret
STRIPE_PRICE_ID_PRO=price_replace_with_your_pro_plan_price_id

# Observability — both optional, off by default (no extra infra required to
# run the app). Set OTEL_EXPORTER_OTLP_ENDPOINT to an OTLP/HTTP collector
# (e.g. a local Jaeger: docker run -d -p 16686:16686 -p 4318:4318
# jaegertracing/all-in-one, then http://localhost:4318) to enable distributed
# tracing across apps/api and apps/worker. Prometheus metrics are always on:
# apps/api serves them at GET /metrics on its normal port; apps/worker (which
# has no other HTTP server) serves them on METRICS_PORT.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
METRICS_PORT=9091

# Data retention (apps/worker): a daily job deletes finished
# (COMPLETED/FAILED) executions and uploaded files past these ages.
# Running executions, pipelines, and connections are never touched.
# EXECUTION_RETENTION_DAYS=90
# FILE_RETENTION_DAYS=180
# RETENTION_CRON=0 3 * * *
