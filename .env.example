# API Settings
PORT=3000
NODE_ENV=development
API_URL=http://localhost:3000
WEB_URL=http://localhost:5173

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/pipeforge

# Redis (BullMQ / Queue)
REDIS_HOST=localhost
REDIS_PORT=6380

# Authentication
JWT_SECRET=super_secret_jwt_key_replace_in_production
JWT_EXPIRES_IN=7d

# File Storage
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# Pipeline execution (worker) — caps how many rows a single node's output can
# hold in memory. A source read (csv-input/json-input) or a join that would
# exceed this fails the execution with a clear error instead of risking an
# OOM. Raise this only alongside worker memory limits.
MAX_PIPELINE_ROWS=200000

# Worker concurrency — how many pipeline executions one worker process runs
# at once. Higher = more throughput but more memory pressure per instance.
WORKER_CONCURRENCY=5

# Email (SMTP) — optional. Without these set, verification/reset emails are
# logged instead of sent, so those flows still work end-to-end in dev.
# Any standard SMTP provider works (SES, SendGrid, Postmark, Mailgun, etc.)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=PipeForge <no-reply@yourdomain.com>
